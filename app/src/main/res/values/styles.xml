<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RegularTextStyle">
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="lineHeight">@dimen/regular_text_style_line_height</item>
        <item name="android:fontWeight">@dimen/regular_text_style_font_weight</item>
    </style>

    <style name="MediumTextStyle">
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="lineHeight">@dimen/medium_text_style_line_height</item>
        <item name="android:fontWeight">@dimen/medium_text_style_font_weight</item>
    </style>

    <style name="MediumTextStyle.22" parent="MediumTextStyle">
        <item name="android:textSize">
            @dimen/text_size_22
        </item>
    </style>

    <style name="RegularTextStyle.12" parent="RegularTextStyle">
        <item name="android:textSize">
            @dimen/text_size_12
        </item>
    </style>

    <style name="MediumTextStyle.22.Header" parent="MediumTextStyle.22">
        <item name="android:paddingTop">@dimen/header_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/header_padding_vertical</item>
        <item name="android:paddingStart">@dimen/header_padding_start</item>
    </style>
    
</resources>
