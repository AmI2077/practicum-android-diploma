<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/search_screen_tab">

    <fragment
        android:id="@+id/search_screen_tab"
        android:name="ru.practicum.android.diploma.feature.search.ui.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_search_screen_tab_to_filterFragment"
            app:destination="@id/filter_screen" />
        <action
            android:id="@+id/action_search_screen_tab_to_vacancyDetailFragment"
            app:destination="@id/vacancyDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/favourites_screen_tab"
        android:name="ru.practicum.android.diploma.feature.favourites.ui.FavouritesFragment"
        android:label="FavouritesFragment"
        tools:layout="@layout/fragment_favourites"/>

    <fragment
        android:id="@+id/team_screen_tab"
        android:name="ru.practicum.android.diploma.feature.team.ui.TeamFragment"
        android:label="TeamFragment"
        tools:layout="@layout/fragment_team"/>

    <fragment
        android:id="@+id/filter_screen"
        android:name="ru.practicum.android.diploma.feature.search.ui.FilterFragment"
        android:label="FilterFragment"
        tools:layout="@layout/fragment_filter">

        <action
            android:id="@+id/action_filter_screen_to_work_place_filter"
            app:destination="@id/work_place_filter" />

        <action
            android:id="@+id/action_filter_screen_to_industry_filter"
            app:destination="@id/industry_filter" />
    </fragment>

    <fragment
        android:id="@+id/vacancyDetailFragment"
        android:name="ru.practicum.android.diploma.feature.detail.ui.VacancyDetailFragment"
        android:label="VacancyDetailFragment"
        tools:layout="@layout/fragment_vacancy_detail">
        <argument
            android:name="vacancyId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/work_place_filter"
        android:name="ru.practicum.android.diploma.feature.filter.ui.WorkPlaceFilterFragment"
        android:label="WorkPlaceFilterFragment"
        tools:layout="@layout/fragment_work_place_filter" />

    <fragment
        android:id="@+id/industry_filter"
        android:name="ru.practicum.android.diploma.feature.filter.ui.IndustryFilterFragment"
        android:label="IndustryFilterFragment"
        tools:layout="@layout/fragment_industry_filter" />

</navigation>
